[unix_http_server]
file=%(ENV_HOME)s/.agent-mesh/supervisor.sock
chmod=0700

[supervisord]
logfile=%(ENV_HOME)s/.agent-mesh/supervisord.log
pidfile=%(ENV_HOME)s/.agent-mesh/supervisord.pid
childlogdir=%(ENV_HOME)s/.agent-mesh
nodaemon=false

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://%(ENV_HOME)s/.agent-mesh/supervisor.sock

[include]
files = %(ENV_HOME)s/.agent-mesh/agent-mesh-node.conf
